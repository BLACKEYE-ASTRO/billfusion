generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  DEBIT_CARD
  WALLET
  INVESTMENT
  LOAN
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

// ==========================================
// USER
// ==========================================

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique

  email     String?
  firstName String?
  lastName  String?
  imageUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings UserSettings?

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  goals        FinancialGoal[]

  notifications Notification[]

  @@index([email])
  @@map("users")
}

// ==========================================
// USER SETTINGS
// ==========================================

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency       String @default("INR")
  currencySymbol String @default("₹")

  dateFormat String @default("DD/MM/YYYY")

  monthlyBudget Decimal? @db.Decimal(12, 2)

  notifications Boolean @default(true)
  weeklyReport  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

// ==========================================
// ACCOUNT
// ==========================================

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  type AccountType @default(BANK)

  balance Decimal @default(0) @db.Decimal(14, 2)

  currency       String @default("INR")
  currencySymbol String @default("₹")

  color String?
  icon  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[] @relation("AccountTransactions")
  transfers    Transaction[] @relation("AccountTransfers")

  @@index([userId])
  @@index([type])
  @@map("accounts")
}

// ==========================================
// CATEGORY
// ==========================================

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  icon  String?
  color String?

  isIncome Boolean @default(false)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  budgetEntries BudgetCategory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// ==========================================
// TRANSACTION
// ==========================================

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  transferAccountId String?
  transferAccount   Account? @relation("AccountTransfers", fields: [transferAccountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  type TransactionType

  amount Decimal @db.Decimal(14, 2)

  description String?
  merchant    String?

  date DateTime @default(now())

  notes String?

  isRecurring Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([type])
  @@index([date])
  @@map("transactions")
}

// ==========================================
// BUDGET
// ==========================================

model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  amount Decimal @db.Decimal(14, 2)

  period BudgetPeriod @default(MONTHLY)

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories BudgetCategory[]

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@map("budgets")
}

// ==========================================
// BUDGET CATEGORY
// ==========================================

model BudgetCategory {
  id String @id @default(cuid())

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  limit Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
  @@map("budget_categories")
}

// ==========================================
// FINANCIAL GOAL
// ==========================================

model FinancialGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  targetAmount Decimal @db.Decimal(14, 2)

  currentAmount Decimal @default(0) @db.Decimal(14, 2)

  deadline DateTime?

  status GoalStatus @default(ACTIVE)

  icon  String?
  color String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("financial_goals")
}

// ==========================================
// NOTIFICATION
// ==========================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  TRANSACTION
  BUDGET
  GOAL
  SECURITY
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}